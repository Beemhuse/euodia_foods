# Browser-visible Sanity identifiers. Never put a write token in NEXT_PUBLIC_*.
NEXT_PUBLIC_SANITY_PROJECT_ID=8bms2xqg
NEXT_PUBLIC_SANITY_DATASET=main
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Server-only credentials. Populate in .env.local; do not commit real values.
SANITY_API_TOKEN=
NEXT_PRIVATE_JWT_SECRET_KEY=
NEXT_PRIVATE_PAYSTACK_SECRET_KEY=
NEXT_PRIVATE_EMAIL=
NEXT_PRIVATE_PASS=
